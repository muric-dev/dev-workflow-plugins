#!/usr/bin/env bash
# did-i-mess-up: a pre-commit hook that asks, before every commit, the only question that matters.
# Blocks commits that carry leftover debug/sabotage code. Its voice is formal, dry and a little funny.
#
#   1. Scans added lines for known "testing on purpose" patterns   (blocking)
#   2. dart format on the staged files                              (blocking)
#   3. flutter analyze + flutter test                               (blocking)
#   4. Haiku reviews the staged diff and gives a verdict            (blocking on BLOCK)
#
# Bypass:  SKIP_HAIKU=1 git commit   (skip only the AI review)
#          git commit --no-verify     (skip everything)

set -uo pipefail

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; BOLD=$'\033[1m'; RESET=$'\033[0m'

say()  { printf '%s\n' "${BOLD}[pre-commit]${RESET} $*"; }
fail() { printf '%s\n' "${RED}${BOLD}[pre-commit] ✗ $*${RESET}"; exit 1; }

FLUTTER="flutter"; DART="dart"
if command -v fvm >/dev/null 2>&1 && [ -f .fvmrc ]; then FLUTTER="fvm flutter"; DART="fvm dart"; fi

# ---------------------------------------------------------------------------
# Work out what is being committed: the staged changes (index vs HEAD).
# ---------------------------------------------------------------------------
DIFF=$(git diff --cached)
CHANGED=$(git diff --cached --name-only --diff-filter=ACM | tr '\n' ' ')

if [ -z "$DIFF" ]; then say "nothing staged. Nothing to mess up, so nothing to check."; exit 0; fi

if ! git diff --quiet -- lib test; then
  say "${YELLOW}note: unstaged changes in lib/ or test/. Format, analyze and test will judge the working tree, not only what you staged.${RESET}"
fi

# ---------------------------------------------------------------------------
# 1. Sabotage / debug leftovers in ADDED lines
# ---------------------------------------------------------------------------
say "1/4 looking for things left in \"just for a second\"…"
PATTERNS=(
  '(final|var|[A-Za-z_][A-Za-z0-9_<>,]*\?)[[:space:]]+[A-Za-z_$][A-Za-z0-9_$]*[[:space:]]*=[[:space:]]*null;'   # final url = null; String? url = null;
  "Image\.(network|asset)\([[:space:]]*(''|\"\")"                      # Image.network('')
  "Uri\.parse\([[:space:]]*(''|\"\")"
  '(^|[^A-Za-z_.])(print|debugPrint)\('
  '//[[:space:]]*(TEMP|DEBUG|HACK|XXX|FIXME|REMOVE|DO NOT (COMMIT|PUSH))'
  'if[[:space:]]*\([[:space:]]*(true|false)[[:space:]]*\)'
  '(solo|skip):[[:space:]]*true'
)
# Dart files only: print( in a script or skip: true in YAML is nobody's leftover.
added=$(git diff --cached -- '*.dart' | grep -E '^\+[^+]' || true)
hits=""
for p in "${PATTERNS[@]}"; do
  m=$(printf '%s\n' "$added" | grep -E -- "$p" || true)
  [ -n "$m" ] && hits+="$m"$'\n'
done
if [ -n "$hits" ]; then
  printf '%s' "$hits" | sed 's/^/    /'
  fail "these lines look left in on purpose. If they are, --no-verify. If not, you messed up, but you caught it."
fi

# ---------------------------------------------------------------------------
# 2. Format (only the staged dart files)
# ---------------------------------------------------------------------------
say "2/4 asking dart format for its opinion…"
dart_files=()
for f in $CHANGED; do
  case "$f" in *.g.dart|*.freezed.dart) ;; *.dart) [ -f "$f" ] && dart_files+=("$f") ;; esac
done
if [ ${#dart_files[@]} -gt 0 ]; then
  $DART format --output=none --set-exit-if-changed "${dart_files[@]}" \
    || fail "the formatter has notes. Run: $DART format ${dart_files[*]} && git add ${dart_files[*]}"
fi

# ---------------------------------------------------------------------------
# 3. Analyze + tests
# ---------------------------------------------------------------------------
say "3/4 flutter analyze, the strict reviewer…"
$FLUTTER analyze --no-pub >/dev/null 2>&1 || { $FLUTTER analyze --no-pub; fail "the analyzer respectfully disagrees with you."; }

if [ -d test ]; then
  say "3/4 flutter test, the honest one…"
  $FLUTTER test --no-pub --reporter failures-only || fail "tests failed. Better here than in review."
else
  say "3/4 no test/ folder, so no tests to fail. Bold, but noted."
fi

# ---------------------------------------------------------------------------
# 4. Haiku sanity review
# ---------------------------------------------------------------------------
if [ "${SKIP_HAIKU:-0}" = "1" ] || ! command -v claude >/dev/null 2>&1; then
  say "4/4 Haiku review skipped. You'll have to wonder on your own."
  printf '%s\n' "${GREEN}${BOLD}[pre-commit] ✓ the machines found nothing. You didn't mess up, as far as they can tell.${RESET}"
  exit 0
fi

say "4/4 asking Haiku, formally: did I mess up?…"
PROMPT='You are a pre-commit gate for a Flutter app. The diff on stdin is about to be committed.
Look ONLY for things a developer left in by accident, especially code changed on purpose
for manual testing: hardcoded null/empty values that override real data, disabled branches,
forced error states, fake delays, commented-out logic, debug prints, skipped tests, or a
change that contradicts what the code/tests around it clearly intend.
Ignore style, naming and formatting.

Reply in plain text, no markdown headers:
- First line exactly "VERDICT: OK" or "VERDICT: BLOCK".
- Then at most 5 short bullets "file:line - issue". If OK, one short reassuring line instead,
  dry and formal with a light touch of humour.
Only BLOCK when you are confident something is wrong.'

# Truncate in bash, not with head: head closing the pipe early makes printf exit 141, and
# pipefail would then discard Haiku's answer on every diff over 150 KB.
review=$(printf '%s' "${DIFF:0:150000}" | \
  perl -e 'alarm shift; exec @ARGV' 120 \
  claude -p "$PROMPT" --model haiku --tools "" --strict-mcp-config \
    --disable-slash-commands --no-session-persistence 2>/dev/null)
status=$?

if [ $status -ne 0 ] || [ -z "$review" ]; then
  say "${YELLOW}Haiku didn't answer (exit $status). Proceeding on trust, which is not blocking.${RESET}"
elif printf '%s' "$review" | head -n 1 | grep -q 'VERDICT: BLOCK'; then
  printf '%s\n' "$review" | sed 's/^/    /'
  fail "Haiku believes you messed up. If you disagree with Haiku: SKIP_HAIKU=1 git commit"
else
  printf '%s\n' "$review" | sed 's/^/    /'
fi

printf '%s\n' "${GREEN}${BOLD}[pre-commit] ✓ you didn't mess up. Probably. Commit away.${RESET}"
exit 0
